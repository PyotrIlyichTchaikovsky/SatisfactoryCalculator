# Frontend build variables for Cloudflare Pages.
PUBLIC_SITE_URL=https://www.example.com
PLANNER_API_BASE_URL=https://production-planner-api-xxxxx.a.run.app
SENTRY_FRONTEND_DSN=
SENTRY_BROWSER_SCRIPT_URL=
ADSENSE_CLIENT=
ADSENSE_ENABLED=false

# Backend runtime variables for Cloud Run.
PLANNER_ALLOWED_ORIGINS=https://www.example.com
PLANNER_MAX_BODY_BYTES=65536
PLANNER_MAX_CONCURRENT_PLANS=2
PLANNER_PLAN_TIMEOUT_SECONDS=15
PLANNER_PLAN_QUEUE_TIMEOUT_SECONDS=0.25
PLANNER_PLAN_CACHE_TTL_SECONDS=900
PLANNER_PLAN_CACHE_MAX_ENTRIES=256
PLANNER_LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# GitHub Actions repository variables.
GCP_PROJECT_ID=
GCP_REGION=asia-east1
ARTIFACT_REGISTRY_REPOSITORY=production-planner
CLOUD_RUN_SERVICE=production-planner-api
CLOUDFLARE_PAGES_PROJECT=production-planner

# GitHub Actions repository secrets.
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
